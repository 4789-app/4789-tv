<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.4789.installer.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__TV_WORKSPACE__/installer/serve.py</string>
    <string>--lan</string>
    <string>--no-open</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__TV_WORKSPACE__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__OWNER_HOME__</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__OWNER_HOME__/Library/Logs/4789-installer-server.log</string>
  <key>StandardErrorPath</key>
  <string>__OWNER_HOME__/Library/Logs/4789-installer-server.log</string>
</dict>
</plist>
